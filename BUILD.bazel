load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@build_bazel_rules_swift//swift:swift.bzl", "swift_binary", "swift_library")

exports_files([
    "Cargo.toml",
    "Package.resolved",
    "Package.swift",
])

# Prototype fixtures that the rebuild's tests read in place: a fixture repository for the Swift tests
# (crates/core/tests/swift_rules.rs), and the prototype's reports for the UI's tests (app/src/*.test.ts).
filegroup(
    name = "prototype_fixture_basic",
    srcs = glob(["Tests/ReviewMapCoreTests/Fixtures/basic/**"]),
    visibility = ["//crates/core:__pkg__"],
)

# The prototype's TypeScript fixture, for crates/core/tests/typescript_fixtures.rs.
filegroup(
    name = "prototype_fixture_typescript",
    srcs = glob(["Tests/ReviewMapCoreTests/Fixtures/typescript/**"]),
    visibility = ["//crates/core:__pkg__"],
)

# Copied to bazel-bin, where rules_js runs the tests.
copy_to_bin(
    name = "prototype_reports",
    srcs = glob(["Tests/ReviewMapCoreTests/Fixtures/*/*.json"]),
    visibility = ["//app:__pkg__"],
)

swift_library(
    name = "ReviewMapCore",
    srcs = glob(["Sources/ReviewMapCore/**/*.swift"]),
    module_name = "ReviewMapCore",
    copts = ["-swift-version", "5"],
    deps = [
        "@swiftpkg_indexstore_db//:IndexStoreDB",
        "@swiftpkg_pathkit//:PathKit",
        "@swiftpkg_swift_syntax//:SwiftParser",
        "@swiftpkg_swift_syntax//:SwiftSyntax",
        "@swiftpkg_tree_sitter//:TreeSitter",
        "@swiftpkg_tree_sitter_go//:TreeSitterGo",
        "@swiftpkg_tree_sitter_rust//:TreeSitterRust",
        "@swiftpkg_tree_sitter_kotlin//:TreeSitterKotlin",
        "@swiftpkg_tomldecoder//:TOMLDecoder",
        "@swiftpkg_tree_sitter_typescript//:TreeSitterTypeScript",
        "@swiftpkg_xcodeproj//:XcodeProj",
        "@swiftpkg_yams//:Yams",
    ],
)

swift_binary(
    name = "reviewmap",
    srcs = glob(["Sources/reviewmap/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = [
        ":ReviewMapCore",
        "@swiftpkg_swift_argument_parser//:ArgumentParser",
    ],
)

config_setting(
    name = "opt",
    values = {"compilation_mode": "opt"},
    visibility = ["//visibility:public"],
)
