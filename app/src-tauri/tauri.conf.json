{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Review Map",
  "version": "0.2.0",
  "identifier": "dev.reviewmap.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Review Map",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/reviewmap-swift-helper", "binaries/reviewmap"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
