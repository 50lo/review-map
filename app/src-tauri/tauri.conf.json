{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Review Map",
  "version": "0.2.0",
  "identifier": "dev.reviewmap.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Review Map",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
